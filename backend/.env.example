# ==============================================================================
# EPA Punjab Social Media Dashboard - Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://epa_user:STRONG_SECURE_PASSWORD@localhost:5432/epa_punjab_dashboard?schema=public"

# Cryptographic Token & Session Secrets (Must be at least 32 characters in production)
JWT_SECRET="GENERATE_A_64_CHARACTER_RANDOM_SECRET_KEY_BEFORE_DEPLOYING"

# Allowed Cross-Origin Origins (Comma-separated)
ALLOWED_ORIGINS="https://dashboard.epa.punjab.gov.pk,http://localhost:3000"

# Scraper Executable Path
SCRAPER_PYTHON_PATH="python"
