# EPA Punjab Social Media Executive Operations Dashboard Credentials
# Enterprise Clean Architecture Template

# Database Persistence (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/epa_social_dashboard?schema=public"
PORT=8080
NODE_ENV=production

# Meta Graph API (Facebook: https://www.facebook.com/EnvironmentProtectionAgencyPunjab/)
FB_PAGE_ID=EnvironmentProtectionAgencyPunjab
FB_ACCESS_TOKEN=

# Instagram Graph API (Instagram: https://www.instagram.com/epapunjablive)
IG_USER_ID=epapunjablive
IG_ACCESS_TOKEN=

# TikTok Official API (TikTok: https://www.tiktok.com/@epapunjab)
TIKTOK_USERNAME=epapunjab
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X (Twitter) API v2 (X: https://x.com/epapunjab)
X_USERNAME=epapunjab
X_BEARER_TOKEN=

# LinkedIn API v2 (LinkedIn: https://pk.linkedin.com/company/environment-protection-agency-punjab)
LINKEDIN_VANITY_NAME=environment-protection-agency-punjab
LINKEDIN_ORGANIZATION_ID=urn:li:organization:environment-protection-agency-punjab
LINKEDIN_ACCESS_TOKEN=

# YouTube Data API v3 (No channel launched yet)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
